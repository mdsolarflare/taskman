{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "deno.ns"]
  },
  "environment": "development",
  "tasks": {
    "test": "deno test --no-check --allow-net=127.0.0.1 --allow-net=localhost --allow-env --allow-read=../public --allow-write=$TEMP,$TMP,$LOCALAPPDATA --allow-run e2e.test.ts",
    "gen-icons": "deno run --no-check --allow-net=127.0.0.1 --allow-env --allow-read=../public --allow-write=../public/icons --allow-run gen_icons.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "lint": {
    "rules": {
      "exclude": []
    }
  }
}
