{
  "name": "taskman-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "serve": "node serve.ts",
    "clean": "node -e \"require('fs').rmSync('public/dist',{recursive:true,force:true})\"",
    "vendor-wasm": "node -e \"require('fs').rmSync('public/dist',{recursive:true,force:true});require('fs').cpSync('../ichor/pkg','public/dist',{recursive:true})\"",
    "gen-revision": "node gen-revision.ts",
    "check": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test e2e/e2e.test.ts",
    "gen-icons": "node e2e/gen_icons.ts",
    "build": "pnpm run clean && pnpm run vendor-wasm && pnpm run check && esbuild src/main.tsx --bundle --minify --jsx=automatic --format=esm --outdir=public/dist --out-extension:.js=.js && pnpm run gen-revision"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
